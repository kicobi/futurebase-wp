# Dependencies
/node_modules/
/vendor/

# project-system design validator deps (dev-only; see tools/project-system/)
/tools/project-system/node_modules/

# Build artifacts: committed in this template (matches upstream them.es/starter-fse).
# Generated projects can flip this if they add a CI build step.
/.dist/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/

# Local environment / secrets
.env
.env.*
!.env.example

# wp-env
.wp-env.override.json

# Composer auth (ACF Pro endpoint, private Composer repos)
auth.json

# Local evidence artifacts (scorecard reports, a11y runs). CI uploads these
# as workflow artifacts; only curated summaries are committed deliberately.
/.artifacts/
/.playwright-mcp/

# Lighthouse CI working directory
/.lighthouseci/

# Composer / PHPStan / PHPCS caches
/.phpunit.cache/
/.phpcs-cache
/phpstan-baseline.neon.bak

# Local settings overrides
/.claude/settings.local.json

# Private planning docs — pricing, internal notes, scope drafts, client history. Never commit.
/planning/

# Promotion recovery state (current + 2.x compatibility reader).
.futurebase-promotion.json
.futurebase-promotion-*.json
.wp-starter-promotion.json
.wp-starter-promotion-*.json

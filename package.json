{
	"name": "futurebase",
	"version": "2.0.0",
	"description": "A modern Full Site Editing foundation for accessible, maintainable WordPress websites.",
	"author": "Colin Lewis",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-theme",
		"block-theme",
		"full-site-editing",
		"wordpress-foundation"
	],
	"homepage": "https://colinlewis.se",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/studiokicobi/futurebase-wp.git"
	},
	"bugs": {
		"url": "https://github.com/studiokicobi/futurebase-wp/issues"
	},
	"private": true,
	"devDependencies": {
		"@lhci/cli": "^0.15.1",
		"@wordpress/env": "^11.11.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/stylelint-config": "^23.36.0",
		"pa11y-ci": "^4.1.1",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"overrides": {
		"lodash": "^4.18.1",
		"serialize-javascript": "^7.0.5",
		"adm-zip": "^0.6.0",
		"markdownlint-cli": "^0.49.1",
		"tmp": "^0.2.6",
		"uuid": "^11.1.1",
		"postcss": "^8.5.25",
		"js-yaml": "^5.2.2"
	},
	"scripts": {
		"start": "wp-scripts start",
		"start:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --config node_modules/@wordpress/scripts/config/webpack.config.js",
		"build": "npm run build:theme && npm run build:blocks",
		"build:theme": "wp-scripts build",
		"build:blocks": "./bin/build-blocks.sh",
		"lint": "wp-scripts lint-js assets webpack.config.js 'src/**/*.{js,jsx}' --no-error-on-unmatched-pattern",
		"lint:js": "wp-scripts lint-js assets webpack.config.js 'src/**/*.{js,jsx}' --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style --allow-empty-input 'assets/**/*.scss' 'src/**/*.scss'",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"verify": "./bin/verify-theme.sh",
		"package": "npm run build && ./bin/package-theme.sh",
		"package:check": "npm run build && ./bin/test-package.sh",
		"rename": "./bin/rename-theme.sh",
		"block:new": "./bin/new-block.sh",
		"cpt:new": "./bin/new-cpt.sh",
		"a11y": "./bin/a11y-wp-env.sh",
		"demo:import": "./bin/demo-content.sh",
		"scorecard": "./bin/scorecard.sh",
		"env:start": "wp-env start --auto-port",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:clean": "wp-env clean all",
		"env:cli": "wp-env run cli wp",
		"test:navigation": "./bin/test-navigation-migration.sh",
		"test:contract": "node --test bin/verify-contract.test.mjs",
		"identity:audit": "./bin/audit-identity.sh",
		"version:audit": "node bin/verify-version-surfaces.mjs"
	}
}

{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wp-starter.local/schemas/journeys.schema.json",
	"title": "Critical user journeys document",
	"description": "A versioned document object of rerunnable critical user journeys that feed baseline/final reports.",
	"type": "object",
	"required": ["schema_version", "kind", "items"],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "type": "integer", "const": 1 },
		"kind": { "type": "string", "const": "journeys" },
		"items": {
			"type": "array",
			"items": { "$ref": "#/definitions/journey" }
		}
	},
	"definitions": {
		"journey": {
			"type": "object",
			"required": ["id", "name", "owner", "steps"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
				"name": { "type": "string", "minLength": 1 },
				"owner": { "type": "string", "enum": ["visitor", "editor", "admin", "member", "customer"] },
				"steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
				"measure_at": {
					"type": "array",
					"items": { "type": "string", "enum": ["baseline", "pre_launch", "launch", "handoff", "30_days", "90_days"] }
				},
				"metrics": {
					"type": "array",
					"items": { "type": "string", "enum": ["completion", "time", "assistance_required", "errors", "steps"] }
				}
			}
		}
	}
}

{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://futurebase.local/schemas/baseline-run.schema.json",
	"title": "Baseline run summary (summary.json)",
	"description": "The machine-readable summary written at the root of each dated baseline/final run directory. Raw evidence lives beside it and is never overwritten.",
	"type": "object",
	"required": ["schema_version", "run_id", "project_type", "status", "modules"],
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"type": "integer",
			"enum": [1, 2],
			"description": "Version 2 requires verifiable evidence paths for successful modules; version 1 remains valid for historical runs."
		},
		"run_id": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z(-[0-9]{2})?$",
			"description": "Dated, sortable run id, e.g. 2026-07-03T100000Z. Ids resolve to the second, so a second run within the same second gets a zero-padded suffix (…Z-02) that preserves the lexical sort."
		},
		"project_type": { "type": "string", "enum": ["new", "redesign"] },
		"kind": { "type": "string", "enum": ["baseline", "final"] },
		"status": {
			"type": "string",
			"enum": ["completed", "completed_with_warnings", "partial", "failed"]
		},
		"started_at": { "type": "string", "format": "date-time" },
		"finished_at": { "type": "string", "format": "date-time" },
		"target": {
			"type": "object",
			"description": "The resolved configuration this run measured, frozen at capture time. Comparison reads it from here rather than from the mutable baseline config, so a before/after pair can be checked for comparability instead of assumed comparable. Absent on runs captured before this field existed.",
			"additionalProperties": false,
			"properties": {
				"base_url": { "type": ["string", "null"] },
				"pages": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "url"],
						"additionalProperties": false,
						"properties": {
							"name": { "type": "string" },
							"url": { "type": "string" }
						}
					}
				},
				"viewports": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "width", "height"],
						"additionalProperties": false,
						"properties": {
							"name": { "type": "string" },
							"width": { "type": "integer" },
							"height": { "type": "integer" }
						}
					}
				},
				"modules": { "type": "array", "items": { "type": "string" } }
			}
		},
		"modules": {
			"type": "array",
			"description": "Per-module status. Modules run independently; a partial run is valid.",
			"items": {
				"type": "object",
				"required": ["module", "status"],
				"additionalProperties": false,
				"properties": {
					"module": {
						"type": "string",
						"enum": ["screenshots", "lighthouse", "axe", "crawl", "wordpress", "hosting", "analytics", "journeys", "manual"]
					},
					"status": {
						"type": "string",
						"enum": ["complete", "complete_with_warnings", "pending", "skipped", "unavailable", "failed"]
					},
					"reason": { "type": "string" },
					"evidence_path": {
						"type": "string",
						"minLength": 1,
						"pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
					},
					"tool": { "type": "string" },
					"tool_version": { "type": "string" }
				}
			}
		},
		"report": { "type": "string", "description": "Relative path to the generated HTML/Markdown report, if any." }
	},
	"allOf": [
		{
			"if": {
				"properties": { "schema_version": { "const": 2 } },
				"required": ["schema_version"]
			},
			"then": {
				"properties": {
					"modules": {
						"items": {
							"allOf": [
								{
									"if": {
										"properties": {
											"status": { "enum": ["complete", "complete_with_warnings"] }
										},
										"required": ["status"]
									},
									"then": { "required": ["evidence_path"] }
								}
							]
						}
					}
				}
			}
		}
	]
}

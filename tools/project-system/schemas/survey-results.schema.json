{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://futurebase.local/schemas/survey-results.schema.json",
	"title": "Survey results",
	"description": "A versioned document holding the answers to one survey period. Null values mean unanswered.",
	"type": "object",
	"required": ["schema_version", "kind", "period", "items"],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "type": "integer", "const": 1 },
		"kind": { "type": "string", "const": "survey-results" },
		"period": { "type": "string", "enum": ["baseline", "30-days", "90-days"] },
		"collected_at": { "type": "string" },
		"respondent": { "type": "string" },
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
					"question": { "type": "string" },
					"value": { "type": ["number", "string", "null"] }
				}
			}
		}
	}
}
